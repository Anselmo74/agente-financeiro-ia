# ===================================================================
# CONFIGURAÇÕES DE AMBIENTE - AGENTE FINANCEIRO IA
# ===================================================================
# Copie este arquivo para .env e preencha com suas credenciais

# OpenRouter AI API
OPENROUTER_API_KEY=sua_chave_aqui
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=google/gemma-2-9b-it:free
OPENROUTER_REFERER=https://seu-app.com

# Configurações de Risco
RISCO_MAXIMO_FINANCEIRO=1000.00
LIMITE_LIQUIDEZ_DIARIA=1000000.00

# Banco de Dados
DB_NAME=trades_historico.db
DB_TIMEOUT=30

# Configurações de Performance
CACHE_TTL_SEGUNDOS=300
MAX_WORKERS_PARALELO=10
TIMEOUT_YFINANCE=15

# Logging
LOG_LEVEL=INFO
LOG_FILE=agente_financeiro.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Streamlit
STREAMLIT_THEME=dark
STREAMLIT_SERVER_PORT=8501
